nextflow.enable.dsl = 2

// ------------------------------------------------------
// Manifest
// ------------------------------------------------------

manifest {
    name = 'moDiNA Nextflow Pipeline'
    author = 'Andrea Raithel, Lis Arend, Fabian Woller'
    description = 'Pipeline for running and evaluating multiple moDiNA configurations'
    version= '0.0.1'
}

process {
    cpus = 4
    memory = '16 GB'

    // Single-threaded batch jobs (see modules/node_ranking and modules/differential_edge_inference)
    withName: 'node_ranking|differential_edge_inference' {
        cpus = 1
        memory = '8 GB'
    }
}

// ------------------------------------------------------
// Profiles
// ------------------------------------------------------
profiles {
    conda {
        conda.enabled = true
        useMamba = true
        docker.enabled = false
        singularity.enabled = false
        createTimeout = '2 h'
    }

    docker {
        docker.enabled = true
        conda.enabled = false
        docker.runOptions = "-u \$(id -u):\$(id -g)"
        process.container = "ghcr.io/dyhealthnet/modina_nf_pipeline_dependencies:main"
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        conda.enabled = false
        docker.enabled = false
        process.container = "ghcr.io/dyhealthnet/modina_nf_pipeline_dependencies:main"
    }

    slurm {
      process.executor = "slurm"
      process.queue = "exbio-cpu"
      process.maxForks = 15 
    }

}

// ------------------------------------------------------
// Global work directory
// ------------------------------------------------------
workDir = params.work_dir ?: './work'

// ------------------------------------------------------
// Configurations
// ------------------------------------------------------
params {
    conda_eval_env = "/nfs/home/students/l.arend/.conda/envs/modina-evaluation-env"
    conda_modina_env = "/nfs/home/students/l.arend/.conda/envs/modina_env"

    name_context_1 = 'Context1'
    name_context_2 = 'Context2'
    run_type = 'file'
    data_type = 'simulation'
    out_dir = './out'
    work_dir = './work'
    evaluation = false

    simulation {
        n_simulations=3
        n_bi=50
        n_cont=50
        n_cat=50
        n_samples_1=500
        n_samples_2=500
        n_shift_cont=4
        n_shift_bi=4
        n_shift_cat=4
        n_corr_cont_cont=2
        n_corr_bi_bi=2
        n_corr_cat_cat=2
        n_corr_bi_cont=2
        n_corr_bi_cat=2
        n_corr_cont_cat=2
        n_both_cont_cont=2
        n_both_bi_bi=2
        n_both_cat_cat=2
        n_both_bi_cont=2
        n_both_bi_cat=2
        n_both_cont_cat=2
        // Each ground truth effect draws its own magnitude uniformly from these ranges; set low==high
        // for the former fixed-magnitude behaviour. The drawn value is recorded per node/edge in the
        // ground truth files, so one run can be binned by realized effect size after the fact.
        corr_low=0.1
        corr_high=0.7
        shift_low=0.2
        shift_high=0.8
        hub_reuse_prob=0.5
        // Shared scale-free background correlation structure, built once and copied to both
        // contexts. Raising background_strength shrinks the budget left for corr_high (see the
        // params files under params_files/simulation).
        background_strength=0.2
        background_density=2
        background_seed=null
        // Seed for planting and sampling, offset by the replicate id; null = not reproducible.
        seed=null
    }

    real_world_data {
        path_context_1 = ""
        path_context_2 = ""
        path_meta = ""
    }

    diff_net_analysis {
        path_config = "input_samplesheet.csv"
        edge_metric = "diff-LPxRE"
        node_metric = "STC-P"
        ranking_algorithm = "PageRank+"
        filter_method = ""
        filter_param = 2
        filter_metric = "raw-P"
        filter_rule = "zero"
        filter_target = ""
        lp_cap = null
        test_type = "nonparametric"
        nan_value = -89
        n_min_valid = 10
        multiple_testing = "bh"

    }

}
