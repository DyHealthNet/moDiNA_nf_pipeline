nextflow.enable.dsl = 2

// ------------------------------------------------------
// Manifest
// ------------------------------------------------------

manifest {
    name = 'moDiNA Nextflow Pipeline'
    author = 'Andrea Raithel, Lis Arend, Fabian Woller'
    description = 'Pipeline for running and evaluating multiple moDiNA configurations'
    version= '0.0.1'
}

process {
    cpus = 4
    memory = '16 GB'

    // Exit 134: the system `tee` (uutils coreutils 0.10, Rust) that the Nextflow task wrapper pipes the
    // output through sometimes aborts ("2nd pipe should have enough spare", seen on kermit, 2026-11-15),
    // which kills an otherwise healthy task. Retry such tasks (on another node, see the slurm profile);
    // every other failure still stops the run.
    errorStrategy = { task.exitStatus == 134 ? 'retry' : 'terminate' }
    maxRetries = 3

    // Single-threaded batch jobs (see modules/node_ranking and modules/differential_edge_inference)
    withName: 'node_ranking|differential_edge_inference' {
        cpus = 1
        memory = '8 GB'
    }
}

// ------------------------------------------------------
// Profiles
// ------------------------------------------------------
profiles {
    conda {
        conda.enabled = true
        useMamba = true
        docker.enabled = false
        singularity.enabled = false
        createTimeout = '2 h'
    }

    docker {
        docker.enabled = true
        conda.enabled = false
        docker.runOptions = "-u \$(id -u):\$(id -g)"
        process.container = "ghcr.io/dyhealthnet/modina_nf_pipeline_dependencies:main"
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        conda.enabled = false
        docker.enabled = false
        process.container = "ghcr.io/dyhealthnet/modina_nf_pipeline_dependencies:main"
    }

    slurm {
      process.executor = "slurm"
      process.queue = "exbio-cpu"
      process.maxForks = 15
      // A retried task (see errorStrategy above) avoids the node where the tee abort was seen
      process.clusterOptions = { task.attempt > 1 ? '--exclude=kermit.exbio.wzw.tum.de' : '' }
    }

    // Machine-specific settings for the statgen server (CHRIS data). Combine with the other profiles,
    // e.g. -profile conda,slurm,statgen; defined after slurm so its queue and cluster options win.
    statgen {
      process.memory = '64 GB'
      process.queue = "computational"
      process.clusterOptions = ''
      params.conda_modina_env = "/home/larend/miniforge3/envs/modina_env"
    }

}

// ------------------------------------------------------
// Global work directory
// ------------------------------------------------------
workDir = params.work_dir ?: './work'

// ------------------------------------------------------
// Configurations
// ------------------------------------------------------
params {
    conda_modina_env = "/nfs/home/students/l.arend/.conda/envs/modina_env"

    name_context_1 = 'Context1'
    name_context_2 = 'Context2'
    run_type = 'file'
    data_type = 'simulation'
    out_dir = './out'
    work_dir = './work'

    simulation {
        n_simulations=3
        n_bi=50
        n_cont=50
        n_cat=50
        n_samples_1=500
        n_samples_2=500
        n_shift_cont=4
        n_shift_bi=4
        n_shift_cat=4
        n_corr_cont_cont=2
        n_corr_bi_bi=2
        n_corr_cat_cat=2
        n_corr_bi_cont=2
        n_corr_bi_cat=2
        n_corr_cont_cat=2
        n_both_cont_cont=2
        n_both_bi_bi=2
        n_both_cat_cat=2
        n_both_bi_cont=2
        n_both_bi_cat=2
        n_both_cont_cat=2
        // Each ground truth effect draws its own magnitude uniformly from these ranges; set low==high
        // for the former fixed-magnitude behaviour. The drawn value is recorded per node/edge in the
        // ground truth files, so one run can be binned by realized effect size after the fact.
        corr_low=0.1
        corr_high=0.7
        shift_low=0.2
        shift_high=0.8
        hub_reuse_prob=0.5
        // Planted hubs: n_hub_* hubs per type, each with k differential edges (k from
        // [hub_degree_low, hub_degree_high]) to random partners, all changed in one context like planted pairs.
        // Ground truth: the hub ('hub'), its partners ('hub partner') and its edges.
        n_hub_cont=0
        n_hub_bi=0
        n_hub_cat=0
        hub_degree_low=3
        hub_degree_high=8
        // Module hubs: n_module_hub_* hubs per type get their whole background correlation row scaled by
        // module_hub_scale in one random context (module background: the hub's module loading shrinks), so
        // all its associations change at once. Ground truth: the hub ('module hub') and its edges with a
        // change >= corr_low; the partners are not ground truth.
        n_module_hub_cont=0
        n_module_hub_bi=0
        n_module_hub_cat=0
        module_hub_scale=0.5
        // Shared background correlation structure, built once and copied to both contexts.
        // 'modules' (default): correlated modules of module_fraction x the number of variables
        // (module_size, if set, overrides it), whose factors correlate at module_correlation.
        // module_fraction 0.1 with module_correlation 0.2 matches the association density of HANCOCK.
        // 'scale_free': a sparse scale-free network from background_strength/background_density;
        // raising background_strength shrinks the budget left for corr_high.
        background_model='modules'
        module_size=null
        module_fraction=0.1
        module_correlation=0.2
        background_strength=0.2
        background_density=2
        background_seed=null
        // MCAR missingness, applied after the data are generated: each variable draws its rate from
        // [missing_low, missing_high] (both 0 = complete data); a share missing_differential of the variables
        // draws a second rate for context 2 (0 = same rate in both contexts, 1 = every variable per context).
        missing_low=0.0
        missing_high=0.0
        missing_differential=0.0
        // Seed for planting and sampling, offset by the replicate id; null = not reproducible.
        seed=null
    }

    real_world_data {
        path_context_1 = ""
        path_context_2 = ""
        path_meta = ""
    }

    diff_net_analysis {
        path_config = "input_samplesheet.csv"
        edge_metric = "diff-LPxRE"
        node_metric = "STC-P"
        ranking_algorithm = "PageRank+"
        // Damping factor (alpha) of PageRank+ / PageRank, in [0, 1): probability of following an edge rather than
        // teleporting (PageRank+: to a node drawn proportional to its node metric). Other algorithms ignore it.
        pagerank_damping = 0.85
        filter_method = ""
        filter_param = 2
        filter_metric = "raw-P"
        filter_rule = "zero"
        filter_target = ""
        test_type = "nonparametric"
        nan_value = -89
        n_min_valid = 10
        multiple_testing = "bh"
        // P-value the p-value based edge/node scores (P, LP, LPxRE, LPxVE, diff-Z) use: "adj-P" (multiple-testing
        // adjusted) or "raw-P" (unadjusted). Both are always stored in the score, edge and STC node files.
        metric_pvalue = "adj-P"

    }

}
